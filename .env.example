# Configuracoes dos testes da Intranet.
#
# As credenciais usadas pelos comandos de administracao ficam em
# cypress.env.json, na chave:
#
# {
#   "intranet": {
#     "usuario": "",
#     "senha": ""
#   }
# }

# Timeout padrao em milissegundos
DEFAULT_TIMEOUT=60000

# Cypress Cloud (opcional)
# CYPRESS_RECORD_KEY=sua_chave_aqui
# CYPRESS_PROJECT_ID=seu_project_id

# Allure Reports (opcional)
ALLURE_RESULTS_PATH=allure-results
ALLURE_REPORT_PATH=allure-report

# Tags para execucao seletiva
# Exemplo: "not @skip and @smoke"
TAGS=not @skip

# Configuracoes de retry
RETRY_RUN_MODE=2
RETRY_OPEN_MODE=0

# URL base do ambiente de testes
BASE_URL=https://hom-intranet.sme.prefeitura.sp.gov.br/
